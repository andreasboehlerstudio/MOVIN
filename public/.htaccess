Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^leistungen/knie-schulter-therapie/?$ /leistungen/ [R=301,L]

  RewriteRule ^api/ - [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_setenvif.c>
  SetEnvIfNoCase Host "^staging\.movin-freiburg\.de$" is_staging
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow" env=is_staging
</IfModule>
